PORT=3000
ENCRYPTION_KEY=
DATABASE_URL=./data/tokens.db
PLUGINS_DIR=./plugins
AUDIT_LOG_DEST=sqlite

# Google Workspace SSO (optional — portal login)
# Redirect URI to register in GCP: ${PORTAL_URL}/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Google plugin OAuth (per-user tool access for the google-* plugins).
# All five sub-plugins (google-gmail, google-drive, google-sheets,
# google-calendar, google-gemini) share these creds. If unset, falls
# back to GOOGLE_CLIENT_ID/SECRET above.
# Register every per-plugin redirect URI in your GCP OAuth client:
#   ${SERVER_PUBLIC_URL}/api/auth/plugin/google-gmail/callback
#   ${SERVER_PUBLIC_URL}/api/auth/plugin/google-drive/callback
#   ${SERVER_PUBLIC_URL}/api/auth/plugin/google-sheets/callback
#   ${SERVER_PUBLIC_URL}/api/auth/plugin/google-calendar/callback
#   ${SERVER_PUBLIC_URL}/api/auth/plugin/google-gemini/callback
GOOGLE_PLUGIN_CLIENT_ID=
GOOGLE_PLUGIN_CLIENT_SECRET=

SESSION_SECRET=random-32-char-min-secret-for-jwt-signing
PORTAL_URL=http://localhost:5173
SERVER_PUBLIC_URL=http://localhost:3000
