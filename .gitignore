# Environment variables
.env
.env.*

# Local MCP client config. Points at whichever workbench the developer is
# running — a deployment hostname or localhost — which is machine-specific
# and, on a public repo, not something to publish.
.mcp.json

# Data
/data/
*.db

# Node
node_modules/
dist/
*.log
coverage/

# Turbo cache
.turbo/

# Generated plugin builds
packages/plugins/**/*.js
packages/plugins/**/*.d.ts

# Handoff scratch
.handoff
temp/
.playwright-mcp/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Playwright CLI snapshots/screenshots (may capture real user PII)
.playwright-cli/

# Generated docs site (built by docs/site/build.mjs in CI)
docs/site/_site/

# Generated copy of the shared design tokens (build.mjs copies this in on every build)
docs/site/assets/tokens.css
docs/site/assets/favicon.svg
docs/site/assets/favicon-32.png
docs/site/assets/apple-touch-180.png
docs/site/assets/og-1200x630.png

# brainstorming visual companion sessions
.superpowers/

# Copied from packages/brand/dist by packages/portal/scripts/copy-brand.mjs
packages/portal/public/

# Generated landing site build and copied design tokens
site/_site/
site/assets/tokens.css

# Assembled GitHub Pages output (site + docs combined; built by CI)
/_pages/
